# Copy this file to `.env` and fill in the values from your Firebase project
# (Firebase console → ⚙ Project settings → General → Your apps → Web app →
# "SDK setup and configuration" → Config). Then restart `npm run dev`.
#
# Without these the app still runs, but in local demo mode: reviews stay in
# your own browser instead of being shared with everyone.
#
# These values are meant to be public — every Firebase web app ships them in
# its JavaScript bundle. What protects your data is firestore.rules, not
# secrecy of this config. The service account key is the one real secret: it
# goes in serviceAccountKey.json, never here, and never in the browser.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# reCAPTCHA v3 site key, used through Firebase App Check so Google verifies
# every write server-side. Public by design — the matching secret key is pasted
# into the Firebase console, never here. Leave it unset and the app still runs;
# it simply sends no App Check token. See SETUP.md.
VITE_RECAPTCHA_SITE_KEY=6Lc...

# Set to true to point the app at the local emulator instead of the real
# project (run `npm run emulators` in another terminal first).
# VITE_FIREBASE_EMULATOR=true
